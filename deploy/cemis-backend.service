[Unit]
Description=CeMIS Backend (Spring Boot)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=cemis
Group=cemis
WorkingDirectory=/opt/cemis/backend
EnvironmentFile=/etc/cemis/backend.env
ExecStart=/usr/bin/java -jar /opt/cemis/backend/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# Modest hardening — relax if the app needs broader filesystem access
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/cemis/data

[Install]
WantedBy=multi-user.target
