# Copy to /etc/cemis/backend.env on the server, fill in real values, then:
#   chmod 600 /etc/cemis/backend.env
#   chown cemis:cemis /etc/cemis/backend.env

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database — point at your own Postgres instance ──────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/cemis
DB_USERNAME=cemis_user
DB_PASSWORD=CHANGE_ME

# ── JWT — generate with: openssl rand -hex 64 ───────────────────────────────────
JWT_SECRET=CHANGE_ME

# ── Email (Gmail SMTP / Google Workspace) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=train@unza.ac.zm
SMTP_PASS=CHANGE_ME
SMTP_FROM=UNZA TeLS <train@unza.ac.zm>

# ── Storage — absolute paths, must be writable by the cemis user ───────────────
CERT_PDF_DIR=/opt/cemis/data/cert-pdfs
BRANDING_DIR=/opt/cemis/data/branding-assets

# ── Backup — pg_dump must be installed (postgresql-client package covers this
# on most distros); only needed if it's not already on PATH ────────────────────
# PG_DUMP_PATH=/usr/bin/pg_dump

# ── Certificate signing secret — any long random string ────────────────────────
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CERT_SIGNING_SECRET=CHANGE_ME

# ── Public URL — used for CORS allow-list and email verify links ───────────────
PUBLIC_URL=https://cemis.unza.ac.zm

# ── Upload size limit — generated certificate PDFs embed the full-resolution
# branding background image. Keep in sync with client_max_body_size in
# deploy/nginx-cemis.conf. Consider shrinking the background image instead of
# raising this further (F:\CIMS\cemis-backend\branding-assets\template-background.png
# is currently ~7MB, which is why this needed raising from the original 10MB).
UPLOAD_MAX_SIZE=25MB
